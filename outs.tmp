czerwone:

case(
	(19:00 <= t < 23:00) && max(tL, tP) < 25, true,
	!(7:00 <= t < 19:00) && max(tL, tP) < 21, true,
	(7:00 <= t < 19:00) || max(tL, tP) > 27, false,
	prawe
)

ledy:

not (lewe || prawe) && (7:05 <= t < 19:00)

prawe:

case(
	(7:00 <= t < 19:00) && max(tL, tP) < 25, true,
	!(7:00 <= t < 19:00) || max(tL, tP) > 28, false,
	lewe
)
